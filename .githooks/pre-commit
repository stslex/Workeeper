#!/bin/sh

# Pre-commit hook to run linting

echo "Running pre-commit checks..."

# Check if we're in a git repository. `-d .git` is NOT that check: in a git worktree
# .git is a FILE, so a directory test silently skips every pre-commit check for every
# commit made from a worktree — a gate that turns itself off exactly where the
# parallel-session workflow runs it. Ask git itself instead.
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Not in a git repository. Skipping pre-commit checks."
    exit 0
fi

# Get list of changed Kotlin files.
#
# The filter must include R (renamed): git reports a MOVED file as R, not M, so with ACM alone a
# commit that only relocates Kotlin sources reports "No Kotlin files changed" and skips detekt.
# See documentation/feature-specs/kmp-phase-6-data-layer.md -> §8.
KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.kt$' || true)

if [ -z "$KOTLIN_FILES" ]; then
    echo "No Kotlin files changed. Skipping linting."
    exit 0
fi

echo "Changed Kotlin files:"
echo "$KOTLIN_FILES"

# Run detekt on changed files
echo "Running detekt..."
if ! ./gradlew detekt --no-configuration-cache --quiet; then
    echo "❌ detekt found issues. Please fix them before committing."
    echo "Run './gradlew detekt --no-configuration-cache' to see the full report."
    echo "Run './gradlew detekt --auto-correct --no-configuration-cache' to auto-fix formatting issues."
    exit 1
fi
echo "✅ detekt checks passed!"

# DISABLED: exit early without running checks
exit 0

# Run Android Lint
echo "Running Android Lint..."
if ! ./gradlew lintDebug --no-configuration-cache --quiet; then
    echo "❌ Android Lint found issues. Please fix them before committing."
    echo "Run './gradlew lintDebug --no-configuration-cache' to see the full report."
    exit 1
fi

echo "✅ All linting checks passed!"
exit 0