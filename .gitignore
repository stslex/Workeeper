*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build

# Assemble outputs. `app/<flavour>/release/` is where AGP drops a release APK, its baseline
# profiles and `output-metadata.json` — ~10 MB that a `git add -A` after `assembleRelease` would
# otherwise commit, and a blob a merge commit keeps forever.
/app/*/release/
/captures
.externalNativeBuild
.cxx
local.properties
.idea
.kotlin
play_config.*
keystore.*
google-services.*
build
vendor/bundle/
fastlane/report.xml
.bundle
fastlane/README.md
.env
.claude.settings.local.*
.obsidian/

# Keep only the portable Graphify snapshot; all other generated outputs stay local.
graphify-out/*
!graphify-out/graph.json
!graphify-out/manifest.json

# shell_gate.py is run directly; its bytecode cache is not an artefact.
documentation/mockups/__pycache__/
# Any `__pycache__`, not just the mockups' one: importing a gate module for a probe writes it
# next to that module, and one slipped into a commit that way.
**/__pycache__/
