<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="io.github.stslex.workeeper.BaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Workeeper"
        tools:targetApi="33">

        <activity
            android:name="io.github.stslex.workeeper.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        Scenario 2 fallback launcher. Started by MainActivity when the
        StartupMigrationCoordinator pre-flight returns RouteToRecovery; the
        user never lands here through the normal launcher icon (no
        intent-filter), so a healthy install never sees this surface.
        -->
        <activity
            android:name="io.github.stslex.workeeper.feature.recovery.RecoveryActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!--
          androidx.work.WorkManagerInitializer is intentionally removed.
          WorkManager uses on-demand initialization via BaseApplication's
          Configuration.Provider + MetroWorkerFactory (see BaseApplication.kt
          and documentation/feature-specs/backup.md → WorkManager setup).
          Restoring the default initializer would create a WorkManager without
          the app's worker factory, so BackupWorker would be built by the
          default reflection factory without its six graph deps. Same
          on-demand integration pattern as before the Hilt→Metro cut.

          Declared once in this shared main manifest rather than duplicated
          across each flavor manifest because both flavors are intentionally
          identical re: WorkManager init. Android lint's
          RemoveWorkManagerInitializer check runs per application module and
          does not see directives contributed via a library manifest, so it
          is suppressed in lint-rules/lint.xml; the AGP manifest merger
          applies this directive correctly at the application-level merge
          (verified in app/dev/build/.../merged_manifest/...).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>