<resources>
    <!--
      Pre-Compose window theme. Its only remaining job is the background painted before
      setContent composes; every colour the app actually renders comes from AppColors in
      core/ui/kit. Nothing here is a design token and nothing here should grow.

      Parent is a platform theme, not AppCompat or MaterialComponents: every activity in the
      app (MainActivity, RecoveryActivity, TestActivity) extends ComponentActivity directly,
      and nothing inflates an AppCompat or Material view, so no support-library ancestry is
      required. Light parent here, dark in values-night, because the platform
      android:Theme.Material.DayNight needs API 29 and minSdk is 28.

      windowBackground is the literal value of AppColors.surfaceTier0 (light variant), so the
      pre-Compose frame matches the first composed frame. XML cannot read a Compose token, so
      these two have to be kept in sync by hand.

      android:statusBarColor is deliberately absent. MainActivity's enableEdgeToEdge owns the
      system bars; the template's hardcoded ?attr/colorPrimaryVariant used to contest it.
    -->
    <style name="Theme.Workeeper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFAFAF8</item>
    </style>
</resources>
