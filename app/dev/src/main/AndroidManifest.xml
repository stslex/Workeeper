<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".DevMobileApp"
        android:label="@string/app_name_dev"
        tools:ignore="MissingApplicationIcon"
        tools:replace="android:name, android:label">

        <meta-data
            android:name="firebase_performance_logcat_enabled"
            android:value="true" />

        <!--
          androidx.work.WorkManagerInitializer is intentionally removed.
          WorkManager uses on-demand initialization via BaseApplication's
          Configuration.Provider + HiltWorkerFactory (see BaseApplication.kt
          and documentation/feature-specs/backup.md → WorkManager setup).
          Restoring the default initializer would create a WorkManager without
          Hilt's worker factory, breaking @AssistedInject construction of
          BackupWorker. This is the Google-documented Hilt + WorkManager
          integration pattern. The block lives here (and in app/store) rather
          than in app/app/src/main because Android lint's
          RemoveWorkManagerInitializer check runs per application module and
          does not see the directive when it is contributed by a library
          module's manifest.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>