    <!--
      The set-type CHIP marks: the work set is the drawn dot, the other three take the first
      letter of their own name in the current language (§26, "Set types take their first letter").
      New — no mockup draws a mark for the three non-work types, so this is a decision and not a
      transcription; the chip keeps its 34x32 and takes no other treatment, the letter occupying
      exactly the dot's place. THE THREE LETTERS ARE TRANSLATED AND MUST STAY RESOURCES: a literal
      in the component draws W over разминка in a Russian build. `..._mark_work` is the same glyph
      in every language, and is a resource anyway so that the four marks live in one table.
    -->
    <string name="core_ui_kit_set_type_mark_warmup">W</string>
    <string name="core_ui_kit_set_type_mark_work" translatable="false">·</string>
    <string name="core_ui_kit_set_type_mark_failure">F</string>
    <string name="core_ui_kit_set_type_mark_drop">D</string>
    <!--
      TalkBack's reorder actions on a `ReorderableColumn` row. They are the only non-gesture way
      to reorder, so they are announced verbatim and must exist in every language the app ships.
    -->
    <string name="core_ui_kit_reorder_move_up">Move up</string>
    <string name="core_ui_kit_reorder_move_down">Move down</string>
