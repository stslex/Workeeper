    <!--
      The exercise type, as the meta line's first token. `#s-list` draws it as a word
      («со весом»), not a glyph: the row has no leading slot, so the information the type tile
      carried has to land in the line, and «сведения, потом теги» puts it at the head where it
      truncates last. The weightless case is not drawn; it is the only sibling of a drawn term.
    -->
    <string name="feature_all_exercises_type_weighted">with weight</string>
    <string name="feature_all_exercises_type_weightless">bodyweight</string>

