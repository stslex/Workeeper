<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- RestoreSuccess -->
    <string name="app_dialog_restore_success_title">Restore complete</string>
    <string name="app_dialog_restore_success_body">Your data was restored from a backup dated %1$s. You can revert to your previous data in Settings if needed.</string>
    <string name="app_dialog_restore_success_body_no_previous">Your data was restored from a backup dated %1$s.</string>
    <string name="app_dialog_restore_success_confirm" tools:ignore="DuplicateStrings">OK</string>
    <string name="app_dialog_restore_success_undo_action" tools:ignore="DuplicateStrings">Undo restore</string>

    <!-- RestoreFailure -->
    <string name="app_dialog_restore_failure_title" tools:ignore="DuplicateStrings">Restore failed</string>
    <string name="app_dialog_restore_failure_body">Your data is intact. Reason: %1$s. Please report this issue so we can fix it.</string>
    <string name="app_dialog_restore_failure_confirm" tools:ignore="DuplicateStrings">OK</string>
    <string name="app_dialog_restore_failure_report_action">Report</string>
    <string name="app_dialog_restore_failure_export_action">Export diagnostics</string>
    <string name="app_dialog_restore_failure_share_chooser">Share diagnostics</string>
    <string name="app_dialog_restore_failure_report_title" tools:ignore="DuplicateStrings">Restore failed</string>

    <!-- UndoRestoreConfirmation -->
    <string name="app_dialog_undo_restore_confirmation_title">Undo last restore?</string>
    <string name="app_dialog_undo_restore_confirmation_body">Your data will revert to the state it was in on %1$s. This cannot be undone.</string>
    <string name="app_dialog_undo_restore_confirmation_confirm" tools:ignore="DuplicateStrings">Undo restore</string>
    <string name="app_dialog_undo_restore_confirmation_cancel">Cancel</string>

    <!-- UndoRestoreSuccess -->
    <string name="app_dialog_undo_restore_success_title">Reverted</string>
    <string name="app_dialog_undo_restore_success_body">Your data has been restored to the previous state.</string>
    <string name="app_dialog_undo_restore_success_confirm" tools:ignore="DuplicateStrings">OK</string>

    <!-- RestoreFailure reasons (BackupErrorCode → user-readable text) -->
    <string name="app_dialog_restore_failure_reason_not_authenticated">not signed in</string>
    <string name="app_dialog_restore_failure_reason_network_unavailable">no network</string>
    <string name="app_dialog_restore_failure_reason_auth_revoked">Google account access was revoked</string>
    <string name="app_dialog_restore_failure_reason_missing_required_scope">Drive access was not granted</string>
    <string name="app_dialog_restore_failure_reason_storage_quota_exceeded">Drive storage is full</string>
    <string name="app_dialog_restore_failure_reason_corrupted_backup">the backup file is corrupted</string>
    <string name="app_dialog_restore_failure_reason_schema_too_new">the backup was created by a newer app version</string>
    <string name="app_dialog_restore_failure_reason_missing_migration_path">no migration path to this app version</string>
    <string name="app_dialog_restore_failure_reason_io">a read or write error occurred</string>
    <string name="app_dialog_restore_failure_reason_unknown">an unexpected error occurred</string>
