    <plurals name="feature_home_recent_sets_count">
        <item quantity="one">%d set</item>
        <item quantity="other">%d sets</item>
    </plurals>

    <!-- Unit word only — the numeral renders separately in the Archivo slot, which carries
         digits only (C2), so the unit cannot join it. Selection still runs on the real count,
         so locales where `one` covers 21, 31, … still pick the right form. -->
    <plurals name="feature_home_start_week_sessions_count" tools:ignore="ImpliedQuantity">
        <item quantity="one">workout</item>
        <item quantity="other">workouts</item>
    </plurals>

    <!-- Unit word only, same construction as the week unit above. -->
    <plurals name="feature_home_start_days_count" tools:ignore="ImpliedQuantity">
        <item quantity="one">day</item>
        <item quantity="other">days</item>
    </plurals>

    <plurals name="feature_home_start_days_idle_count">
        <item quantity="one">%d day</item>
