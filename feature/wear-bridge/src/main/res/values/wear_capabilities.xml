<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Capability discovery carries no workout payload. Workout transport is authorized by the
         Phase 1 gate closure record (wear-phase-1-active-workout-tile.md §6.1); the watch discovers
         the phone by WearProtocol.PHONE_CAPABILITY, which a phone test pins to this item.
         Nothing in code references the array, so release builds keep it through
         res/raw/workeeper_wear_bridge_keep.xml: a tools:keep on this file's root is not read by
         R8's resource shrinker. assert_play_bundle.py G9 checks the release bundle. -->
    <string-array
        name="android_wear_capabilities"
        tools:ignore="Typos">
        <item>workeeper_phone_active_workout_v1</item>
    </string-array>
</resources>
